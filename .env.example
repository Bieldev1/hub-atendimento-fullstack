# Copie este arquivo para ".env" (já ignorado pelo git) e ajuste os valores para o seu ambiente local.
# Nunca commite o arquivo ".env" com credenciais reais.

MSSQL_SA_PASSWORD=Your_password123!
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
# Evite "@", ":" ou "/" na senha do Mongo: o mongo-express monta a connection string
# mongodb://user:senha@host sem fazer URL-encode, e esses caracteres quebram o parsing.
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=Your_password123
